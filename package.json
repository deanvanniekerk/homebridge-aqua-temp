{
  "name": "homebridge-aqua-temp-connect",
  "version": "1.0.3",
  "description": "Aqua Temp heat pump controls and temperature sensors for Homebridge",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.4.0"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "aqua",
    "temp",
    "aqua-temp",
    "heat-pump",
    "thermostat"
  ],
  "license": "MIT",
  "author": "Dean van Niekerk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanvanniekerk/homebridge-aqua-temp.git"
  },
  "files": [
    "dist/**/*.js",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE_STEPS.md",
    "docs/INSTALLATION.md",
    "docs/CONFIGURATION.md",
    "docs/images/homebridge-configuration.png",
    "docs/COMPATIBILITY.md",
    "docs/ARCHITECTURE.md",
    "docs/PROJECT_STRUCTURE.md",
    "docs/VALIDATION.md",
    "docs/RELEASING.md",
    "docs/SPEC.md",
    "CONTRIBUTING.md",
    "scripts/check-release.mjs",
    "scripts/release-notes.mjs"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pretest": "npm run build",
    "test": "vitest run",
    "check": "biome check . && npm run check:runtime",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-release.mjs",
    "check:runtime": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "homebridge": "2.4.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/deanvanniekerk/homebridge-aqua-temp#readme",
  "bugs": {
    "url": "https://github.com/deanvanniekerk/homebridge-aqua-temp/issues"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
