{
  "name": "@deanvanniekerk/homebridge-aqua-temp",
  "version": "0.0.0-development.0",
  "description": "Independent Aqua Temp Homebridge plugin foundation; device controls are not implemented",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": "^22.23.2",
    "homebridge": "^2.4.0"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "homebridge-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanvanniekerk/homebridge-aqua-temp.git"
  },
  "files": [
    "dist/*.js",
    "config.schema.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"throw new Error('Publishing is disabled until release preparation (#11).')\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "homebridge": "2.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
